# ---------------------------------------------------------------------------
# Sovereign Workbench — example environment. Copy to `.env` and edit.
# NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=development
LOG_LEVEL=info

# When true, ONLY loopback/private-network endpoints are allowed. Any attempt to
# reach a public host is blocked AND written to the audit log. Keep true for the
# SIH demo.
AIRGAP=true

# --- Local inference (default: Ollama, OpenAI-compatible at /v1) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# llama.cpp server alternative:
LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Path to the model registry (tiers, capabilities, providers).
MODEL_REGISTRY_PATH=./models/models.toml
HARDWARE_TIER=min

# Docker auto-selection requires Docker access and a locally cached image.
# Use docker for strong isolation; subprocess is the best-effort laptop fallback.
SANDBOX_BACKEND=auto
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
MAX_AGENT_STEPS=12
TOOL_TIMEOUT_SECONDS=120

# Hashing is download-free. sentence-transformers requires locally provisioned weights.
EMBEDDING_PROVIDER=hashing
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Optional cloud fallback (DISABLED automatically when AIRGAP=true) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Storage paths (created on first run) ---
DATA_DIR=./data
WORKSPACE_DIR=./data/workspace
ARTIFACTS_DIR=./data/artifacts
UPLOADS_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vectorstore
DATABASE_URL=sqlite:///./data/workbench.sqlite3
