# ---------------------------------------------------------------------------
# Sovereign Workbench — example environment. Copy to `.env` and edit.
# NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=development
LOG_LEVEL=info

# When true, ONLY loopback/private-network endpoints are allowed. Any attempt to
# reach a public host is blocked AND written to the audit log. Keep true for the
# SIH demo.
AIRGAP=true

# --- Local inference (default: Ollama, OpenAI-compatible at /v1) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# llama.cpp server alternative:
LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Path to the model registry (tiers, capabilities, providers).
MODEL_REGISTRY_PATH=./models/models.toml

# --- Optional cloud fallback (DISABLED automatically when AIRGAP=true) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Storage paths (created on first run) ---
DATA_DIR=./data
WORKSPACE_DIR=./data/workspace
ARTIFACTS_DIR=./data/artifacts
UPLOADS_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vectorstore
DATABASE_URL=sqlite:///./data/workbench.sqlite3
