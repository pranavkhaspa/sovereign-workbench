# Frontend calls the backend through the dev proxy (vite.config.ts) and the same
# origin in production, so no base URL is required. Kept for future overrides.
VITE_API_BASE=""

# "true" runs the whole UI against the in-browser mock transport: no backend
# required, a scripted agent stream plays on a timer. Used for screenshots,
# demos and frontend-only development.
VITE_USE_MOCK="false"
