# Compose backend image; the build context is the repository root.
FROM python:3.12-slim

ARG BACKEND_EXTRAS=ocr
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libgomp1 \
        poppler-utils \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml backend/README.md /app/backend/
COPY backend/src /app/backend/src
RUN python -m pip install "/app/backend[${BACKEND_EXTRAS}]"

RUN useradd --create-home --uid 10001 workbench \
    && mkdir -p /app/data /app/models \
    && chown -R workbench:workbench /app
COPY --chown=workbench:workbench models /app/models

USER workbench
ENV AIRGAP=true \
    HARDWARE_TIER=min \
    MODEL_REGISTRY_PATH=/app/models/models.toml \
    DATABASE_URL=sqlite:////app/data/workbench.sqlite3

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["python", "-m", "uvicorn", "sovereign_workbench.main:app", "--host", "0.0.0.0", "--port", "8000"]
